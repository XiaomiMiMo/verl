# Environment for the general arm (s3k enterprise-function tasks).
#   source scripts/general/general.env   &&   bash scripts/general/general.sh
#
# Copy to scripts/general/general.env and fill in. That file is gitignored; never commit a
# key.

# --- required ---------------------------------------------------------------

# The open_source_env bundle root. Must contain envs/ and parquet/. Every row's
# env_task_dir is the relative path envs/<uid>, so the launcher cd's here before starting.
export GA_TASK_ROOT=/path/to/open_source_env

# HF hub id or a local checkpoint directory.
export MODEL_PATH=Qwen/Qwen3.5-9B

# Any kubeconfig with pod-create permission in K8S_NAMESPACE. Each rollout starts one pod
# with two containers. Check with: kubectl auth can-i create pods
export KUBECONFIG=$HOME/.kube/config

# The LLM judge. Reward on this arm is a judge scoring each task's rubric of pass/fail
# assertions, so a run without a reachable endpoint reports zeros that look like a policy
# collapse. Any OpenAI-compatible server works (vLLM / SGLang / Ollama / the OpenAI API).
export GA_JUDGE_URL=http://localhost:8000/v1
export GA_JUDGE_KEY=EMPTY
export GA_JUDGE_MODEL=gpt-4o-mini
export GA_JUDGE_API=chat

# --- cluster and registry ---------------------------------------------------
# Not checked up front, but an unset one surfaces only as a pod event minutes later.

# Where you pushed the task images. The bundle's docker/build.sh emits bare names
# (general-agent-env:oss plus 65 termsyn candidates) and this supplies the prefix.
export DOCKER_REGISTRY=registry.example.com/ns

export K8S_NAMESPACE=default
# export K8S_IMAGE_PULL_SECRET=my-regcred          # private registry
# export K8S_TOLERATION_KEY=dedicated              # tainted nodes
# export K8S_TOLERATION_VALUE=my-pool
# export K8S_NODE_LABEL_KEY=node-pool              # pin a node pool
# export K8S_NODE_LABEL_VALUE=gpu-a100

# --- optional ---------------------------------------------------------------

# export EXP_NAME=ga_train
# export NNODES=4
# export NGPUS_PER_NODE=8

# Fallback channel for the judge key. Some clusters filter env vars out of Ray's
# runtime_env, which leaves the reward path without a key; the environment class reads this
# path explicitly instead of guessing at one. Expects channels.judge.api_key in a yaml.
# export GA_JUDGE_KEY_FILE=/path/to/channels.yaml

# Rollouts per prompt when GENERAL_MODE=eval. pass@N is reported as
# val-core/mimoagent/general_agent/reward/mean@N.
# export VAL_KWARGS_N=4

# Per-rollout trajectory dumps land here (one directory per rollout, traj.json inside).
# export TRAJ_DUMP_DIR=$HOME/general_traj
