# Copy this file to arvo.env and source it before launching, or export the
# variables directly.  Only MODEL_PATH, TRAIN_DATA and VAL_DATA are required;
# everything else has a default in scripts/arvo/arvo.sh.

# --- required ---------------------------------------------------------------
export MODEL_PATH=""           # SFT checkpoint (HuggingFace format)
export TRAIN_DATA=""           # rl_mixed_train_1000_oss.parquet
export VAL_DATA=""             # rl_mixed_test_182_oss.parquet

# --- cluster ----------------------------------------------------------------
# export KUBECONFIG=""         # kubeconfig with pod-create permission
# export NNODES=8
# export NGPUS_PER_NODE=8

# --- optional overrides (defaults match the reference run) ------------------
# export ROLLOUT_TP=2
# export TRAIN_BATCH_SIZE=64
# export ROLLOUT_N=16
# export MAXLEN=262144
# export PROMPT_LENGTH=16384
